# TrackForge example secrets.
#
# Copy to .env next to config.toml (or into the config directory) and fill in
# only the values you need. Never commit the real .env file.
# Recommended permissions: chmod 600 .env

# LLM used for source identity extraction, claim extraction and adjudication.
# config.toml points at this variable via [llm] api_key_env.
TRACKFORGE_LLM_API_KEY=

# Optional metadata providers. MusicBrainz requires a contact User-Agent,
# AcoustID requires an application API key.
TRACKFORGE_ACOUSTID_API_KEY=
TRACKFORGE_MUSICBRAINZ_USER_AGENT="TrackForge/0.1 (you@example.com)"

# Optional proxies. Standard HTTP(S)_PROXY variables are intentionally ignored;
# prefer [network.*] proxy settings in config.toml.
# TRACKFORGE_YTDLP_PROXY=
# TRACKFORGE_METADATA_PROXY=
# TRACKFORGE_LLM_PROXY=
# TRACKFORGE_MODELS_PROXY=
